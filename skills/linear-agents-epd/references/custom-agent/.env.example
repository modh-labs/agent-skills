# Linear OAuth app (actor=app). Register at linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=          # signing secret for Linear-Signature (HMAC-SHA256)
# App OAuth token captured at install (actor=app). In production, store one per workspace and look it
# up by organizationId rather than using a single env var.
LINEAR_APP_TOKEN=

# Anthropic, drives the agent's reasoning via the Claude Agent SDK
ANTHROPIC_API_KEY=

# Supabase, durable session + idempotency store (server/service-role only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Internal wiring
APP_BASE_URL=https://your-app.vercel.app   # used to trigger the worker route
INTERNAL_TRIGGER_SECRET=                    # shared secret between webhook route and worker route
